{
  "name": "remote-claude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run Claude Code in a Cloudflare Sandbox instead of on your local machine",
  "license": "MIT",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sdk:build": "npm --prefix sdk run build",
    "sdk:typecheck": "npm --prefix sdk run typecheck",
    "prepare": "npm --prefix sdk install --no-audit --no-fund && npm run sdk:build",
    "embed": "node scripts/embed-runner.mjs",
    "pretypecheck": "node scripts/embed-runner.mjs && wrangler types",
    "run:local": "node scripts/run-locally.mjs"
  },
  "devDependencies": {
    "@cloudflare/sandbox": "^0.12.4",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  },
  "bin": {
    "remote-claude": "./cli/remote-claude.mjs"
  },
  "dependencies": {
    "@r-hashi01/remote-claude-client": "file:./sdk"
  }
}
