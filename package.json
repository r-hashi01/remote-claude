{
  "name": "remote-claude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run Claude Code in a Cloudflare Sandbox instead of on your local machine",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node src/acp.test.ts",
    "embed": "node scripts/embed-runner.mjs",
    "pretypecheck": "node scripts/embed-runner.mjs",
    "run:local": "node scripts/run-locally.mjs"
  },
  "devDependencies": {
    "@cloudflare/sandbox": "^0.12.4",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.119.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  },
  "bin": {
    "remote-claude": "./cli/remote-claude.mjs"
  }
}
