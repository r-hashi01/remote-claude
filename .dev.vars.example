# Copy to `.dev.vars` for local `wrangler dev`. NEVER commit `.dev.vars`.
# It is covered by the repository .gitignore - verify with:
#   git check-ignore -v infra/remote-claude/.dev.vars

# The Claude credential. Exactly ONE of the two below — which one is set is what
# selects the auth scheme, and there is no variable that overrides that choice.
# Both set means every job is refused with a message saying so, because which
# account pays would be undecided.

# Long-lived Claude subscription OAuth token.
# Generate locally with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# …or a Claude API key from https://platform.claude.com/ — pay-as-you-go, and the
# credential to use when anything other than you at a keyboard drives this.
# ANTHROPIC_API_KEY=

# Shared bearer token that guards this Worker's HTTP API.
# Generate with:  openssl rand -hex 32
REMOTE_CLAUDE_TOKEN=

# GitHub App used to clone/push the repository (README "GitHub App を用意する").
# GITHUB_APP_PRIVATE_KEY must be PKCS#8 ("-----BEGIN PRIVATE KEY-----"). GitHub
# issues PKCS#1 keys, so convert once with:
#   openssl pkcs8 -topk8 -nocrypt -in original-key.pem -out pkcs8-key.pem
# Paste the pkcs8-key.pem contents below with real newlines, or "\n"-escaped
# on a single line.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Only needed when WORKSPACE_CACHE=on
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# NOTE: never set both Claude credentials. A deployment authenticates with one of
# them, and holding two is refused rather than resolved by precedence — see
# docs/adr/0014-two-credentials-one-at-a-time.md.
