{
  "compilerOptions": {
    "target": "es2022",
    // DOM rather than @types/node: the only ambient names this package needs
    // are fetch, Response, RequestInit and AbortSignal, all of which Node has
    // had globally since 18. Taking them from DOM keeps the package free of
    // dependencies, including type-only ones.
    "lib": ["es2022", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
