{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remote-claude",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // This is a private, single-user control plane. Bearer auth already fails
  // closed, but per-version preview hostnames only widen the attack surface
  // for no benefit here, so turn them off explicitly rather than inheriting
  // wrangler's default-on behaviour.
  "preview_urls": false,

  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      // "basic" matches Cloudflare's official Claude Code example.
      // Bump to "standard" if heavy builds get OOM-killed (see README).
      "instance_type": "basic",
      // Hard platform-level ceiling on cost. Keep >= MAX_CONCURRENCY.
      "max_instances": 3
    }
  ],

  // Domain state (Project/Task/Event/Update/Output/...) lives here, not in a
  // Durable Object: DO storage is per-object and cannot serve the cross-project
  // queries the product needs. See docs/spindle-data-model-v0.1.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spindle",
      "database_id": "e55ca88e-1b20-4b7d-9ed4-3c2f6544eccd",
      "migrations_dir": "migrations"
    }
  ],

  // Output bodies (patches, log archives). D1 has a 2 MB row limit and these
  // grow without bound, so only the R2 key is stored in the database.
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "spindle-artifacts"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "class_name": "Sandbox", "name": "Sandbox" },
      { "class_name": "TaskManager", "name": "TASKS" },
      { "class_name": "AgentSession", "name": "ACP" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox", "TaskManager"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AgentSession"]
    }
  ],

  "vars": {
    // Repository this environment works on. Overridable per task only if
    // ALLOW_CUSTOM_REPO is "true" (off by default - see README security notes).
    "REPO_URL": "https://github.com/r-hashi01/spindle.git",
    "DEFAULT_BASE_BRANCH": "main",

    // RPC transport is the current recommended mode; HTTP/WebSocket transport
    // is deprecated (sandbox/guides/2026-deprecation).
    "SANDBOX_TRANSPORT": "rpc",

    // "proxy"  : real OAuth token never enters the container. The Worker's
    //            outbound handler swaps a placeholder for the real token on
    //            requests to api.anthropic.com. RECOMMENDED.
    // "direct" : real OAuth token is passed to the claude process as an env
    //            var inside the container.
    "CLAUDE_AUTH_MODE": "proxy",

    "MAX_CONCURRENCY": "3",
    "TASK_TIMEOUT_MS": "1800000",
    "CLAUDE_TIMEOUT_MS": "1500000",
    "SANDBOX_SLEEP_AFTER": "5m",

    // Safety switches. Both off by default.
    "ALLOW_PUSH": "false",
    "ALLOW_CUSTOM_REPO": "false",

    // "off" | "on". "on" additionally requires the R2 config below.
    "WORKSPACE_CACHE": "off",
    "WORKSPACE_CACHE_TTL": "604800",

    // Outbound allowlist for the sandbox. Everything else is dropped.
    "SANDBOX_ALLOWED_HOSTS": "github.com,codeload.github.com,api.github.com,objects.githubusercontent.com,api.anthropic.com,registry.npmjs.org,pypi.org,files.pythonhosted.org,proxy.golang.org,crates.io,static.crates.io",

    // Project commands. Empty string = skip that step.
    "INSTALL_COMMAND": "npm --prefix infra/remote-claude install --no-audit --no-fund",
    "TEST_COMMAND": "npm --prefix infra/remote-claude test",
    // Left empty deliberately: `typecheck` needs worker-configuration.d.ts,
    // which is gitignored and regenerated by `wrangler types` (network access
    // the sandbox allowlist does not grant). Revisit if that changes.
    "LINT_COMMAND": "",
    "BUILD_COMMAND": ""
  }

  // --- Optional: workspace caching via R2 (WORKSPACE_CACHE=on) -----------
  // Uncomment this block, create the bucket, then set the two R2 secrets.
  // See README "Workspace cache (phase 2)".
  //
  // ,"r2_buckets": [
  //   { "binding": "BACKUP_BUCKET", "bucket_name": "remote-claude-cache" }
  // ]
}
