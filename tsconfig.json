{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  // Tests are included: they are the only consumer of `application/testing.ts`
  // and the first place a broken port shows up.
  "include": ["src/**/*.ts", "vitest.config.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "cli", "sdk/dist"]
}
